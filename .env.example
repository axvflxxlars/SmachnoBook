# Скопіюйте цей файл у .env і заповніть значення.
# Файл .env не потрапляє в Git (див. .gitignore).

# Секретний ключ Django: підписує JWT-токени, сесії тощо. Обов'язковий.
# Згенерувати новий:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-generated-secret-key

# Режим налагодження. Для локальної розробки True, на сервері завжди False.
DEBUG=True

# Адреси, за якими доступний бекенд (через кому)
ALLOWED_HOSTS=127.0.0.1,localhost

# Адреси фронтенду, яким дозволено звертатися до API (через кому)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Термін дії JWT-токенів
ACCESS_TOKEN_LIFETIME_MINUTES=5
REFRESH_TOKEN_LIFETIME_DAYS=1

# Рівень логування застосунків recipes і users: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
